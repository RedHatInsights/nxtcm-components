{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@playwright/test", "vite/client"],
    "moduleResolution": "bundler",
    "module": "esnext"
  },
  "include": [
    "playwright/**/*",
    "playwright.config.ts",
    "playwright-ct.config.ts",
    "vite.e2e.config.ts",
    "e2e-app/**/*",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
