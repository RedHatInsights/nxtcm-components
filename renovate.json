{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "packageRules": [
    {
      "description": "Disable major updates for peerDependency packages across all depTypes (including sibling devDependencies). These names are the peerDependencies from root and workspace package.json files, update this list whenever those peers change.",
      "matchPackageNames": [
        "@monaco-editor/react",
        "@patternfly/react-charts",
        "@patternfly/react-code-editor",
        "@patternfly/react-core",
        "@patternfly/react-icons",
        "@patternfly/react-table",
        "@patternfly/widgetized-dashboard",
        "js-yaml",
        "monaco-editor",
        "monaco-yaml",
        "react",
        "react-dom"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group non-security patch updates into a single PR",
      "matchUpdateTypes": ["patch"],
      "matchJsonata": ["isVulnerabilityAlert != true"],
      "groupName": "all patch updates"
    },
    {
      "description": "Group ESLint ecosystem packages into a single PR",
      "matchPackageNames": ["eslint", "@eslint/**", "@typescript-eslint/**", "eslint-*"],
      "groupName": "eslint packages"
    },
    {
      "description": "Group test framework packages into a single PR",
      "matchPackageNames": [
        "jest",
        "jest-*",
        "@jest/**",
        "@playwright/**",
        "@axe-core/**",
        "@stryker-mutator/**"
      ],
      "groupName": "test frameworks"
    },
    {
      "description": "Group PatternFly packages across all workspaces",
      "matchPackageNames": ["@patternfly/**"],
      "groupName": "patternfly"
    },
    {
      "description": "Group React packages across all workspaces",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "description": "monaco-editor/monaco-yaml are tightly version-coupled. Require manual, deliberate upgrades.",
      "matchPackageNames": ["monaco-editor", "monaco-yaml", "@monaco-editor/react"],
      "enabled": false
    }
  ],
  "reviewers": [
    "nitin-dhevar",
    "davidaznaur",
    "jloss-redhat",
    "vishsanghishetty",
    "brandonthanhnguyen",
    "kelvah",
    "d3mdis",
    "LukeAllen13"
  ],
  "reviewersSampleSize": 2,
  "dependencyDashboard": true,
  "minimumReleaseAge": "4 days",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "commitMessageSuffix": "[SECURITY]",
    "prCreation": "immediate"
  }
}
